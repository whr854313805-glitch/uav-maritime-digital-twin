		<ActiveObjectClass>
			<Id>1775452015905</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[traceln("Deduplicating vessel agents (keeping first per vessel_id)...");
java.util.HashSet<String> seen = new java.util.HashSet<String>();
java.util.ArrayList<Vessel> toRemove = new java.util.ArrayList<Vessel>();
for (Vessel v : vessel) {
    if (seen.contains(v.vessel_id)) {
        toRemove.add(v);
    } else {
        seen.add(v.vessel_id);
    }
}
for (Vessel v : toRemove) {
    remove_vessel(v);
}
traceln("Remaining vessel agents: " + vessel.size());

// ---- Diagnostic real-time probe ----
// Runs in a background Java thread every 1 real second. Writes sim time + vessel count to
// step_log.txt. If sim time stays at 0, the simulation is paused; if it advances, OnStepCode
// simply isn't being invoked for our agents.
final Main self = this;
java.util.Timer _probeTimer = new java.util.Timer("uav-probe", true);
_probeTimer.scheduleAtFixedRate(new java.util.TimerTask() {
    int iter = 0;
    public void run() {
        iter++;
        try {
            java.io.FileWriter fw = new java.io.FileWriter("/Users/rozz/Desktop/pre/uav-maritime-twin/output/step_log.txt", true);
            fw.write("PROBE iter=" + iter + " simtime=" + self.time() + " vessels=" + self.vessel.size() + "\n");
            fw.close();
        } catch(Exception ex) {}

        // Also push position updates directly from this real-time thread as a fallback —
        // if sim time is advancing, this effectively replaces OnStepCode.
        try {
            int minute = (int)(self.time() / 60);
            if (minute >= 1440) return;
            Object cached = System.getProperties().get("_uav_vessel_positions");
            java.util.HashMap<String, java.util.ArrayList<double[]>> positions;
            if (cached == null) {
                positions = new java.util.HashMap<String, java.util.ArrayList<double[]>>();
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader("/Users/rozz/Desktop/pre/uav-maritime-twin/output/vessel_positions.csv"));
                br.readLine();
                String ln;
                while ((ln = br.readLine()) != null) {
                    String[] parts = ln.split(",");
                    if (parts.length < 3) continue;
                    String vid = parts[0];
                    double lat = Double.parseDouble(parts[1]);
                    double lon = Double.parseDouble(parts[2]);
                    java.util.ArrayList<double[]> lst = positions.get(vid);
                    if (lst == null) { lst = new java.util.ArrayList<double[]>(); positions.put(vid, lst); }
                    lst.add(new double[]{lat, lon});
                }
                br.close();
                System.getProperties().put("_uav_vessel_positions", positions);
            } else {
                positions = (java.util.HashMap<String, java.util.ArrayList<double[]>>) cached;
            }
            for (Vessel v : self.vessel) {
                java.util.ArrayList<double[]> lst = positions.get(v.vessel_id);
                if (lst != null && minute < lst.size()) {
                    double[] p = lst.get(minute);
                    v.setLatLon(p[0], p[1]);
                }
            }
        } catch(Exception ex) {
            try {
                java.io.FileWriter fw = new java.io.FileWriter("/Users/rozz/Desktop/pre/uav-maritime-twin/output/step_log.txt", true);
                fw.write("PROBE ERR: " + ex.getMessage() + "\n");
                fw.close();
            } catch(Exception e2) {}
        }
    }
}, 1000, 1000);
traceln("Real-time probe timer scheduled (every 1s).");]]></StartupCode>
